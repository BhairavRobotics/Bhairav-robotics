# Forminit Configuration (Careers form - supports file uploads)
# Get form ID from https://forminit.com (create form, recipient: ravi.sarma@bhairavrobotics.in)
# Docs: https://forminit.com/docs/file-upload/
VITE_FORM_INIT_ID=your_forminit_form_id

# Web3Forms Configuration (Contact form - text only)
# Get key from https://www.web3forms.com (recipient: ravi.sarma@bhairavrobotics.in)
VITE_WEB3FORMS_CONTACT_KEY=your_contact_access_key
