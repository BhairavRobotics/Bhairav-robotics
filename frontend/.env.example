# Forminit Configuration (Careers form - supports file uploads)
# Get form ID from https://forminit.com (create form, recipient: contact@bhairavrobotics.in)
# Docs: https://forminit.com/docs/file-upload/
VITE_FORM_INIT_CAREERS_ID=your_careers_form_id

# Web3Forms Configuration (Contact form - text only)
# Get key from https://www.web3forms.com (recipient: contact@bhairavrobotics.in)
VITE_WEB3FORMS_CONTACT_KEY=your_contact_access_key

# Brochure email (Vercel serverless function / backend SMTP) - set these in
# Vercel dashboard for Production, values from backend/.env (Zoho SMTP).
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_SECURE=true
# EMAIL_USER=contact@bhairavrobotics.in
# EMAIL_PASS=your_smtp_app_password
# HR_EMAIL=contact@bhairavrobotics.in
