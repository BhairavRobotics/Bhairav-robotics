{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/favicon.ico", "/*.css", "/*.js", "/*.png", "/*.jpg", "/*.jpeg", "/*.gif", "/*.svg", "/*.woff*", "/*.ttf", "/*.eot"]
  },
  "headers": [
    {
      "route": "/assets/*",
      "headers": [
        { "header": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
